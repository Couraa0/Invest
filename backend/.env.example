# InvestAI Backend (Express.js) Environment Variables

# API Key untuk Groq (Model Llama 3 untuk chatbot / AI Mentor)
GROQ_API_KEY=your-groq-api-key-here

# Connection String untuk Azure SQL Database
AZURE_SQL_URL="Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-db;Persist Security Info=False;User ID=your-username;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"

# Google Client ID untuk verifikasi token SSO Google
GOOGLE_CLIENT_ID=your-google-client-id-here

# Secret Key untuk penandatanganan JSON Web Token (JWT)
JWT_SECRET=your-secure-jwt-secret-key-here
