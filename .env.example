# InvestAI Frontend Environment Variables

# URL untuk Backend AI (FastAPI - Port 8000)
VITE_API_BASE=http://localhost:8000

# URL untuk Backend Utama (Express.js - Port 5000)
VITE_NODE_API=http://localhost:5000

# Google Client ID untuk fitur Login with Google
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
